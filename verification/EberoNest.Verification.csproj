<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>EberoNest.Verification</AssemblyName>
    <RootNamespace>EberoNest.Verification</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.2</Version>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
    <InformationalVersion>1.0.2</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Organizer.cs" Link="Organizer.cs" />
    <Compile Include="..\Rules.cs" Link="Rules.cs" />
    <Compile Include="..\StartupMode.cs" Link="StartupMode.cs" />
    <Compile Include="..\StartupManager.cs" Link="StartupManager.cs" />
    <Compile Include="..\UpdateChecker.cs" Link="UpdateChecker.cs" />
    <Compile Include="..\Localization.cs" Link="Localization.cs" />
    <Compile Include="..\EberoNestForm.cs" Link="EberoNestForm.cs" />
    <Compile Include="..\OfficialRepositoryLink.cs" Link="OfficialRepositoryLink.cs" />
    <Compile Include="..\SettingsForm.cs" Link="SettingsForm.cs" />
    <Compile Include="..\RulesListControl.cs" Link="RulesListControl.cs" />
    <EmbeddedResource Include="..\assets\app-icon.ico">
      <LogicalName>EberoNest.Assets.app-icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\app-icon.png">
      <LogicalName>EberoNest.Assets.app-icon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\tray_normal.ico">
      <LogicalName>EberoNest.Assets.tray_normal.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\tray_active.ico">
      <LogicalName>EberoNest.Assets.tray_active.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\tray_paused.ico">
      <LogicalName>EberoNest.Assets.tray_paused.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
